#version 120

varying vec2 objectTexCoord;
varying vec4 objectColor;
uniform sampler2D dsoTexture;
uniform int useTexture;

void main() {
	vec2 point = objectTexCoord * 2.0 - 1.0;
	float radiusSquared = dot(point, point);
	if (radiusSquared > 1.0)
		discard;

	// Stellarium's default DSO markers are a soft, additive region. For
	// photographic Messier objects, retain the source image and use its
	// alpha/luminance as the radial falloff.
	float glow = exp(-2.6 * radiusSquared) * (1.0 - 0.18 * radiusSquared);
	vec4 image = useTexture == 1 ? texture2D(dsoTexture, objectTexCoord) : vec4(1.0);
	float imageAlpha = useTexture == 1 ? max(image.a, dot(image.rgb, vec3(0.3333))) : 1.0;
	gl_FragColor = vec4(objectColor.rgb * image.rgb * glow,
			objectColor.a * imageAlpha * glow);
}
