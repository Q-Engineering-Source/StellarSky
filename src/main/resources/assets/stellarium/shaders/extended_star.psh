#version 120
#extension GL_ARB_point_sprite : enable

varying vec3 starColor;
varying float starIntensity;
uniform sampler2D starHalo;

void main() {
	vec2 point = gl_PointCoord * 2.0 - 1.0;
	float radiusSquared = dot(point, point);
	if (radiusSquared > 1.0)
		discard;
	float core = smoothstep(1.0, 0.0, radiusSquared);
	float halo = exp(-3.5 * radiusSquared);
	vec4 textureHalo = texture2D(starHalo, gl_PointCoord);
	float textureProfile = dot(textureHalo.rgb, vec3(0.3333));
	float profile = textureProfile + 0.35 * (core + 0.32 * halo);
	gl_FragColor = vec4(starColor * starIntensity * profile, 1.0);
}
