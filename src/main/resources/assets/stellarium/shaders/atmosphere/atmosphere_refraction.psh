#version 120

uniform sampler2D texture;

vec4 encode(vec4 color)
{
    vec4 vEncoded;
    vec3 rgb = max(color.rgb, vec3(0.0));
    float maxComponent = max(max(rgb.r, rgb.g), rgb.b);
    if (maxComponent <= 1.0e-20)
        return vec4(0.0, 0.0, 0.0, 128.0 / 255.0);
    float fExp = ceil( log2(maxComponent) );
    vEncoded = vec4(rgb / exp2(fExp), 0.0);
    vEncoded.a = (fExp + 128) / 255;
    return vEncoded;
}

vec4 decode(vec4 rgbe)
{
    vec4 vDecoded;
    float fExp = rgbe.a * 255 - 128;
    vDecoded = rgbe * exp2(fExp);
    return vDecoded;
}

void main() {
    gl_FragColor = encode(texture2D(texture, gl_TexCoord[0].st));
}
